

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             Padding="10"
                             Spacing="12">

            <Label Text="Reserva Confirmada!"
                   TextColor="{StaticResource Primary}"
                   FontFamily="Kalam"
                   FontSize="36"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="lbl_quarto"
                   Text="Suíte Super Luxo"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Frame Margin="5" Padding="15">
                <StackLayout Orientation="Horizontal">

                    <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                        <Label Text="Adultos:" />
                        <Label x:Name="lbl_adultos"
                               Text="2"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                        <Label Text="Crianças:" />
                        <Label x:Name="lbl_criancas"
                               Text="1"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>

                </StackLayout>
            </Frame>

            <Frame Margin="5" Padding="15">
                <Grid ColumnDefinitions="*, *, *"
                      RowDefinitions="Auto, Auto"
                      RowSpacing="12">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Check-in:"
                           FontAttributes="Bold" />

                    <Label Grid.Row="0" Grid.Column="1"
                           Text="Check-out:"
                           FontAttributes="Bold" />

                    <Label Grid.Row="0" Grid.Column="2"
                           Text="Estadia:"
                           FontAttributes="Bold" />

                    <Label x:Name="lbl_checkin"
                           Grid.Row="1" Grid.Column="0"
                           Text="15/11/2026" />

                    <Label x:Name="lbl_checkout"
                           Grid.Row="1" Grid.Column="1"
                           Text="18/11/2026" />

                    <Label x:Name="lbl_estadia"
                           Grid.Row="1" Grid.Column="2"
                           Text="3 dias" />

                </Grid>
            </Frame>

            <Frame Margin="5" Padding="20">
                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">

                    <Label Text="Valor Total:"
                           FontAttributes="Bold" />

                    <Label x:Name="lbl_valor_total"
                           Text="R$ 495,00"
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Bold" />

                </HorizontalStackLayout>
            </Frame>

            <Button Text="Voltar"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    WidthRequest="200"
                    Clicked="Button_Clicked" />

            <Label Text="Desenvolvido por Estéfano Soares"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center"
                   Margin="0,15,0,5" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
